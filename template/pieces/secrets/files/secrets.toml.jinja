# Secrets manifest for `hoist secrets exec`. Values stay encrypted in the secrets repos below;
# nothing here is secret. `hoist secrets check` validates this file.
#
# Rules:
# - version is 1.
# - Left side: the env var name in the child process, [A-Z_][A-Z0-9_]*.
# - Right side: "<source>:<path>#<key>" with <source> declared in [sources].
# - <path> matches ^[a-z0-9-]+/[a-z0-9._-]+\.sops\.yaml$ and starts with the environment name.
# - The environment name equals the GitHub environment (and the CircleCI context suffix).
version = 1

[sources]
shared = { repo = "{{ scope }}/secrets-shared" } # ref defaults to "main"

[env.preview]
CLOUDFLARE_API_TOKEN = "shared:preview/cloudflare.sops.yaml#CLOUDFLARE_API_TOKEN"
CLOUDFLARE_ACCOUNT_ID = "shared:preview/cloudflare.sops.yaml#CLOUDFLARE_ACCOUNT_ID"

[env.prod]
CLOUDFLARE_API_TOKEN = "shared:prod/cloudflare.sops.yaml#CLOUDFLARE_API_TOKEN"
CLOUDFLARE_ACCOUNT_ID = "shared:prod/cloudflare.sops.yaml#CLOUDFLARE_ACCOUNT_ID"
