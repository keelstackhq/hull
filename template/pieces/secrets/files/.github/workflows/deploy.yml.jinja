{% if "circleci-only" in pieces %}{% else %}{% raw %}name: deploy

# Deploys main to production. Trusted code only: it runs on push to main, never on a PR.
on:
  push:
    branches: [main]
  workflow_dispatch:

concurrency:
  group: deploy-prod
  cancel-in-progress: false

permissions:
  contents: read

jobs:
  # No environment, no secrets: a repo without a deployable app never reaches the `prod` environment.
  gate:
    # A dispatch from another ref does nothing. The binding control is the `prod` environment with
    # deployment branches = Selected, main; this `if` is only a convenience.
    if: github.ref == 'refs/heads/main'
    runs-on: ubuntu-latest
    timeout-minutes: 5
    outputs:
      deploy: ${{ steps.detect.outputs.deploy }}
    steps:
      - uses: actions/checkout@v5
        with:
          persist-credentials: false
      - name: Any deployable app?
        id: detect
        run: |
          if compgen -G "apps/*/wrangler.jsonc" > /dev/null; then
            echo "deploy=true" >> "$GITHUB_OUTPUT"
          else
            echo "deploy=false" >> "$GITHUB_OUTPUT"
          fi
  deploy:
    needs: gate
    if: github.ref == 'refs/heads/main' && needs.gate.outputs.deploy == 'true'
    runs-on: ubuntu-latest
    timeout-minutes: 15
    environment: prod
    steps:
      - uses: actions/checkout@v5
        with:
          persist-credentials: false
      - uses: pnpm/action-setup@v4
      - uses: actions/setup-node@v5
        with:
          node-version-file: .node-version
          package-manager-cache: false
      - name: Install
        run: pnpm install --frozen-lockfile --prefer-offline
      - uses: keelstackhq/hoist/secrets@0000000000000000000000000000000000000000 # TODO(hoist-release)
        with:
          env: prod
          keys: CLOUDFLARE_API_TOKEN,CLOUDFLARE_ACCOUNT_ID
          run: pnpm turbo run deploy --filter=./apps/*
          app-id: ${{ vars.SECRETS_READ_APP_ID }}
          app-key: ${{ secrets.SECRETS_READ_APP_KEY }}
          age-key: ${{ secrets.SOPS_AGE_KEY }}
{% endraw %}{% endif %}