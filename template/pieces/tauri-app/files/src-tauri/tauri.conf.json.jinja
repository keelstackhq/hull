{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "{{ name }}",
  "version": "0.0.0",
  "identifier": "dev.{{ scope }}.{{ name }}",
  "build": {
    "beforeDevCommand": "pnpm --filter @{{ scope }}/{{ frontend }} dev",
    "beforeBuildCommand": "pnpm --filter @{{ scope }}/{{ frontend }} build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../{{ frontend }}/dist"
  },
  "app": {
    "windows": [{ "title": "{{ name }}", "width": 1024, "height": 768 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
