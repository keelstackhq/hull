{
  "name": "{{ name }}",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "vars": {
    "LOG_LEVEL": "info",
    "SENTRY_DSN": "",
  },
  // OTel export (e.g. Axiom) is configured in the Cloudflare dashboard, then referenced here.
  // Lines below are illustrative: verify against https://developers.cloudflare.com/workers/observability/exporting-opentelemetry-data/
  // "observability": { "logs": { "destinations": ["axiom-logs"] }, "traces": { "destinations": ["axiom-traces"] } },
}
