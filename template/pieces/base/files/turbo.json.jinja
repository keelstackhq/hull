{
  "$schema": "https://turbo.build/schema.json",{# same-branches #}{% if "rust-cli" in pieces %}
  "globalDependencies": [
    "vite.config.ts",
    "tsconfig.base.json",
    "Cargo.toml",
    "Cargo.lock",
    "rust-toolchain.toml"
  ],{% elif "rust-tool" in pieces %}
  "globalDependencies": [
    "vite.config.ts",
    "tsconfig.base.json",
    "Cargo.toml",
    "Cargo.lock",
    "rust-toolchain.toml"
  ],{% endif %}{% if "rust-cli" in pieces %}{% elif "rust-tool" in pieces %}{% else %}
  "globalDependencies": ["vite.config.ts", "tsconfig.base.json"],{% endif %}
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**"] },
    "lint": {},
    "format:check": {},
    "//#format:check": {
      "inputs": [
        "package.json",
        "turbo.json",
        "tsconfig.base.json",
        "vite.config.ts",
        "pnpm-workspace.yaml",
        "renovate.json",
        "CLAUDE.md",
        "AGENTS.md",
        "README.md",
        ".claude/**",
        ".github/**",
        "scripts/**",
        "docs/**"
      ]
    },
    "typecheck": { "dependsOn": ["^build"] },
    "test": { "dependsOn": ["^build"] },
    "dev": { "cache": false, "persistent": true },
    "deploy": {
      "dependsOn": ["build"],
      "cache": false,
      "passThroughEnv": ["CLOUDFLARE_API_TOKEN", "CLOUDFLARE_ACCOUNT_ID"]
    },
    "storybook:build": { "outputs": ["storybook-static/**"] },
    "build:desktop": { "cache": false }
  }
}
