{# same-branches #}{% if "rust-cli" in pieces %}[workspace]
resolver = "3"
members = [
{# same-branches #}{% if "rust-cli" in pieces %}  "crates/*",
{% elif "rust-tool" in pieces %}  "crates/*",
{% endif %}{% if "tauri-app" in pieces %}  "apps/*/src-tauri",
{% endif %}]

[workspace.lints.rust]
unsafe_code = "forbid"

[workspace.lints.clippy]
all = { level = "warn", priority = -1 }

[profile.release]
lto = "thin"
