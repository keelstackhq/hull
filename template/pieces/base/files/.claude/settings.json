{
  "model": "opusplan",
  "permissions": {
    "allow": [
      "Bash(pnpm:*)",
      "Bash(cargo:*)",
      "Bash(turbo:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(gh run view:*)",
      "Bash(docspack:*)"
    ],
    "deny": [
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push +*)",
      "Bash(git push * +*)",
      "Bash(pnpm publish:*)",
      "Bash(npm publish:*)",
      "Bash(cargo publish:*)",
      "Read(.env*)",
      "Read(**/.env*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Grep|Glob|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh\"",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-checks.sh\"",
            "timeout": 120
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "superpowers-marketplace": {
      "source": { "source": "github", "repo": "obra/superpowers-marketplace" }
    },
    "akramsystems-plugins": {
      "source": { "source": "github", "repo": "akramsystems/caveman" }
    }
  },
  "enabledPlugins": {
    "superpowers@superpowers-marketplace": true,
    "caveman@akramsystems-plugins": true
  }
}
