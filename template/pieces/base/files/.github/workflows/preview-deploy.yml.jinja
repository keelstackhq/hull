{% raw %}name: preview-deploy

# Runs the default-branch definition of this file after `preview` finishes. It never checks out or
# runs PR code: the artifact is pre-bundled output, uploaded with `wrangler versions upload --no-bundle`.
on:
  workflow_run:
    workflows: [preview]
    types: [completed]

concurrency:
  group: preview-deploy-${{ github.event.workflow_run.head_repository.full_name }}-${{ github.event.workflow_run.head_branch }}
  cancel-in-progress: true

permissions:
  contents: read
  actions: read
  pull-requests: read

jobs:
  # No environment, no secrets: a repo without a deployable app never reaches the `preview` environment.
  gate:
    if: github.event.workflow_run.conclusion == 'success' && github.event.workflow_run.event == 'pull_request' && github.event.workflow_run.head_repository.full_name == github.repository
    runs-on: ubuntu-latest
    timeout-minutes: 5
    outputs:
      deploy: ${{ steps.detect.outputs.deploy }}
    steps:
      - uses: actions/checkout@fbc6f3992d24b796d5a048ff273f7fcc4a7b6c09 # v5.1.0
        with:
          persist-credentials: false
      - name: Any deployable app?
        id: detect
        run: |
          if compgen -G "apps/*/wrangler.jsonc" > /dev/null; then
            echo "deploy=true" >> "$GITHUB_OUTPUT"
          else
            echo "deploy=false" >> "$GITHUB_OUTPUT"
          fi
  deploy:
    needs: gate
    if: needs.gate.outputs.deploy == 'true' && github.event.workflow_run.conclusion == 'success' && github.event.workflow_run.event == 'pull_request' && github.event.workflow_run.head_repository.full_name == github.repository
    runs-on: ubuntu-latest
    timeout-minutes: 15
    environment: preview
    steps:
      # No ref: the default branch (scripts, wrangler.jsonc, lockfile), never the PR head.
      - uses: actions/checkout@fbc6f3992d24b796d5a048ff273f7fcc4a7b6c09 # v5.1.0
        with:
          persist-credentials: false
      - uses: pnpm/action-setup@fc06bc1257f339d1d5d8b3a19a8cae5388b55320 # v4.4.0
      - uses: actions/setup-node@a0853c24544627f65ddf259abe73b1d18a591444 # v5.0.0
        with:
          node-version-file: .node-version
          package-manager-cache: false
      - name: Install
        run: pnpm install --frozen-lockfile --prefer-offline
      # The PR number comes from the event or the API, never from the artifact.
      - name: PR number
        id: pr
        env:
          GH_TOKEN: ${{ github.token }}
          EVENT_PRS: ${{ toJSON(github.event.workflow_run.pull_requests) }}
          REPO: ${{ github.repository }}
          HEAD_SHA: ${{ github.event.workflow_run.head_sha }}
        run: |
          n=$(jq -r --arg sha "$HEAD_SHA" '[.[] | select(.head.sha == $sha)][0].number // empty' <<< "$EVENT_PRS")
          if [ -z "$n" ]; then
            n=$(gh api "repos/$REPO/commits/$HEAD_SHA/pulls" --jq '[.[] | select(.head.sha == $ENV.HEAD_SHA and .head.repo.full_name == $ENV.REPO)][0].number // empty')
          fi
          case "$n" in '' | *[!0-9]*) echo "no pull request for this run" >&2; exit 1 ;; esac
          echo "number=$n" >> "$GITHUB_OUTPUT"
      - uses: actions/download-artifact@634f93cb2916e3fdff6788551b99b062d0335ce0 # v5.0.0
        with:
          name: preview-${{ steps.pr.outputs.number }}
          path: ${{ runner.temp }}/preview
          run-id: ${{ github.event.workflow_run.id }}
          github-token: ${{ github.token }}
{% endraw %}{% if "secrets" in pieces %}{% raw %}      - uses: keelstackhq/hoist/secrets@24b2dcbcd98ba0f0b8dd228e814bbcf3c7d4319f # v0.3.0
        env:
          PR_NUMBER: ${{ steps.pr.outputs.number }}
          PREVIEW_ARTIFACT: ${{ runner.temp }}/preview
        with:
          env: preview
          keys: CLOUDFLARE_API_TOKEN,CLOUDFLARE_ACCOUNT_ID
          run: node .github/scripts/preview.mjs deploy
          app-id: ${{ vars.SECRETS_READ_APP_ID }}
          app-key: ${{ secrets.SECRETS_READ_APP_KEY }}
          age-key: ${{ secrets.SOPS_AGE_KEY }}
          # workflow_run: hoist checks the triggering workflow (preview.yml) by its file path
          workflow-run-path: .github/workflows/preview.yml{% endraw %}{% else %}{% raw %}      - name: Deploy previews
        env:
          CLOUDFLARE_API_TOKEN: ${{ secrets.CLOUDFLARE_API_TOKEN }}
          CLOUDFLARE_ACCOUNT_ID: ${{ secrets.CLOUDFLARE_ACCOUNT_ID }}
          PR_NUMBER: ${{ steps.pr.outputs.number }}
          PREVIEW_ARTIFACT: ${{ runner.temp }}/preview
        run: node .github/scripts/preview.mjs deploy{% endraw %}{% endif %}
