{
  "name": "{{ scope }}",
  "private": true,
  "type": "module",
  "scripts": {
    "ci": "turbo run lint format:check typecheck test build --affected && (if [ -f scripts/ci-extra.sh ]; then bash scripts/ci-extra.sh; fi)",
    "check": "turbo run lint format:check typecheck test",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "vp fmt",
{% if "docs" in pieces %}    "docs:packs": "node scripts/docs-packs.mjs",
    "docs:sync": "docspack sync && docspack index --repo",
{% endif %}    "agents:index": "node scripts/agents-index.mjs",
    "format:check": "vp fmt --check package.json turbo.json tsconfig.base.json vite.config.ts pnpm-workspace.yaml renovate.json CLAUDE.md AGENTS.md README.md .claude .github scripts docs",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
{% if "docs" in pieces %}    "docspack": "catalog:",
{% endif %}    "turbo": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@12.11.2"
}
