{
  "vars": {
    "scope": "hullci"
  },
  "combos": [
    {
      "name": "base",
      "pieces": ["base"]
    },
    {
      "name": "web",
      "pieces": ["base", "preact-app:web", "ui-storybook", "hono-worker:api"]
    },
    {
      "name": "desktop",
      "pieces": ["base", "preact-app:web", "tauri-app:desktop"],
      "scheduled": true
    },
    {
      "name": "site",
      "pieces": ["base", "astro-site:site", "rust-tool:tool"]
    },
    {
      "name": "docs",
      "pieces": ["base", "docs"]
    },
    {
      "name": "cli",
      "pieces": ["base", "rust-cli:cli", "npm-cli:cli"]
    },
    {
      "name": "lib",
      "pieces": ["base", "ts-lib:lib"]
    },
    {
      "name": "rust",
      "template": "template-rust",
      "pieces": ["base", "rust-cli:cli"],
      "vars": {}
    }
  ]
}
