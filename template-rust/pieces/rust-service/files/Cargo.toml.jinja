[package]
name = "{{ service }}"
version = "0.0.0"
edition.workspace = true
rust-version.workspace = true
publish = false

[[bin]]
name = "{{ service }}"
path = "src/main.rs"

[lints]
workspace = true

# Versions equal pins.toml [crates]; `node scripts/pins.mjs --check` fails on drift.
[dependencies]
axum = { version = "=0.8.9", default-features = false, features = ["http1", "tokio"] }
tokio = { version = "=1.54.1", features = ["rt-multi-thread", "macros", "net", "signal", "time"] }
{% if "sqlite" in pieces %}sqlx = { version = "=0.9.1", default-features = false, features = ["sqlite", "runtime-tokio", "migrate", "macros"] }
hyper = { version = "=1.12.0", default-features = false, features = ["client", "http1"], optional = true }
hyper-util = { version = "=0.1.21", default-features = false, features = ["tokio"], optional = true }
http-body-util = { version = "=0.1.5", optional = true }
rustls = { version = "=0.23.46", default-features = false, features = ["ring", "std", "tls12"], optional = true }
tokio-rustls = { version = "=0.26.6", default-features = false, features = ["ring", "tls12"], optional = true }
webpki-roots = { version = "=1.0.12", optional = true }
sha2 = { version = "=0.11.1", optional = true }
hmac = { version = "=0.13.0", optional = true }
{% endif %}
[dev-dependencies]
tower = { version = "=0.5.3", features = ["util"] }
{% if "sqlite" in pieces %}
# sqlite piece. Off by default: the snapshot upload (S3/R2, SigV4 by hand over rustls) adds about
# ten crates.
[features]
s3-backup = ["dep:hyper", "dep:hyper-util", "dep:http-body-util", "dep:rustls", "dep:tokio-rustls", "dep:webpki-roots", "dep:sha2", "dep:hmac"]
{% endif %}