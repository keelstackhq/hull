name: deploy

# Deploys the sha that `ci` just tested, on the default branch only. Secrets (FLY_API_TOKEN) live in
# the `production` environment and never reach pull-request code: the pull-request image build is
# image.yml. A manual run deploys the default branch head, which may not have passed ci. Fork pull requests never
# deploy: only a push event from this repository counts. With the circleci-only piece there is no
# `ci` workflow, so deploy by hand (workflow_dispatch) or from your own trigger.
on:
  workflow_run:
    workflows: [ci]
    types: [completed]
  workflow_dispatch:

permissions:
  contents: read

# A deploy is never cancelled: the next one waits for it. The group is on the job, not the workflow:
# skipped runs (pull requests, merge_group) then never take the single pending slot and cancel a
# waiting deploy of the default branch. The top-level group is unique per run, so it cancels nothing;
# it is there because bosun's ci-minutes gate wants a top-level concurrency on every workflow.
{% raw %}concurrency:
  group: deploy-run-${{ github.run_id }}
  cancel-in-progress: true

jobs:
  deploy:
    concurrency:
      group: deploy-production
      cancel-in-progress: false
    if: (github.event_name == 'workflow_run' && github.event.workflow_run.conclusion == 'success' && github.event.workflow_run.event == 'push' && github.event.workflow_run.head_repository.full_name == github.repository && github.event.workflow_run.head_branch == github.event.repository.default_branch) || (github.event_name == 'workflow_dispatch' && github.ref == format('refs/heads/{0}', github.event.repository.default_branch))
    runs-on: ubuntu-latest
    timeout-minutes: 20
    environment: production
    steps:
      - uses: actions/checkout@fbc6f3992d24b796d5a048ff273f7fcc4a7b6c09 # v5.1.0
        with:
          ref: ${{ github.event.workflow_run.head_sha || github.sha }}
          persist-credentials: false
      # Checked out code is only built remotely by Fly; flyctl is the one step that sees the token.
      - uses: superfly/flyctl-actions/setup-flyctl@ed8efb33836e8b2096c7fd3ba1c8afe303ebbff1 # v1.6.0
      - run: flyctl deploy --remote-only
        env:
          FLY_API_TOKEN: ${{ secrets.FLY_API_TOKEN }}
      - name: Smoke test /healthz
        run: |
          app="$(sed -n 's/^app *= *"\(.*\)".*/\1/p' fly.toml | head -n 1)"
          SMOKE_URL="https://$app.fly.dev" bash scripts/smoke.sh
{% endraw %}
